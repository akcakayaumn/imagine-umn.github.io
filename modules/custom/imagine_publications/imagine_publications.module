<?php 

use Drupal\Component\Utility\Html;
use Drupal\Core\Cache\Cache;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Url;

/**
 * Implements hook_preprocess_HOOK() for views-view-fields.html.twig.
 */
function imagine_publications_preprocess_views_view_fields(array &$variables): void {
  if ($variables['view']->id() !== 'bibcite_publications') {
    return;
  }

  $entity = $variables['row']->_entity ?? NULL;
  if (!$entity instanceof EntityInterface) {
    return;
  }

  $title = $entity->label();
  $variables['pub_title'] = $title;
  $variables['pub_links'] = [];

  $map = [
    'paper' => [
      'field' => 'field_bibcite_pdf_link',
      'label' => t('Paper'),
      'aria' => t('Read the full paper: @title', ['@title' => $title]),
    ],
    'code' => [
      'field' => 'field_bibcite_code_link',
      'label' => t('Code'),
      'aria' => t('View the code repository for: @title', ['@title' => $title]),
    ],
  ];

  foreach ($map as $key => $info) {
    // Requirement 1: skip anything not filled out.
    if (!$entity->hasField($info['field']) || $entity->get($info['field'])->isEmpty()) {
      continue;
    }
    $item = $entity->get($info['field'])->first();
    try {
      // Resolves internal:/ and entity:/ URIs, not just absolute ones.
      $url = Url::fromUri($item->uri)->toString();
    }
    catch (\InvalidArgumentException $e) {
      // A malformed URI would otherwise white-screen the whole view.
      continue;
    }
    $variables['pub_links'][$key] = [
      'url' => $url,
      'label' => $info['label'],
      'aria' => $info['aria'],
    ];
  }

  // BibTeX is generated by bibcite, not stored in a field.
  $variables['pub_bibtex'] = NULL;
  if (\Drupal::moduleHandler()->moduleExists('bibcite_bibtex')) {
    try {
      $bibtex = trim(\Drupal::service('serializer')->serialize($entity, 'bibtex'));
      if ($bibtex !== '') {
        $variables['pub_bibtex'] = $bibtex;
        $variables['pub_bibtex_id'] = Html::getUniqueId('pub-bibtex-' . $entity->id());
      }
    }
    catch (\Throwable $e) {
      \Drupal::logger('imagine_publications')->warning('BibTeX serialization failed for @id: @msg', [
        '@id' => $entity->id(),
        '@msg' => $e->getMessage(),
      ]);
    }
  }

  $variables['#attached']['library'][] = 'imagine_publications/publications';

  // Reading _entity directly bypasses the field render arrays that would
  // normally bubble this up.
  $variables['#cache']['tags'] = Cache::mergeTags(
    $variables['#cache']['tags'] ?? [],
    $entity->getCacheTags()
  );
}