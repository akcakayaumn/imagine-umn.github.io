<?php

use Drupal\Component\Utility\Html;
use Drupal\Core\Cache\Cache;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;
use Symfony\Component\HttpFoundation\File\UploadedFile;

/**
 * Implements hook_preprocess_HOOK() for views-view-fields.html.twig.
 */
function imagine_publications_preprocess_views_view_fields(array &$variables): void {
  if ($variables['view']->id() !== 'bibcite_publications') {
    return;
  }

  $entity = $variables['row']->_entity ?? NULL;
  if (!$entity instanceof EntityInterface) {
    return;
  }

  $title = $entity->label();
  $variables['pub_title'] = $title;
  $variables['pub_links'] = [];

  $map = [
    'paper' => [
      'field' => 'field_bibcite_pdf_link',
      'label' => t('Paper'),
      'aria' => t('Read the full paper: @title', ['@title' => $title]),
    ],
    'code' => [
      'field' => 'field_bibcite_code_link',
      'label' => t('Code'),
      'aria' => t('View the code repository for: @title', ['@title' => $title]),
    ],
  ];

  foreach ($map as $key => $info) {
    if (!$entity->hasField($info['field']) || $entity->get($info['field'])->isEmpty()) {
      continue;
    }
    $item = $entity->get($info['field'])->first();
    try {
      // Resolves internal:/ and entity:/ URIs, not just absolute ones.
      $url = Url::fromUri($item->uri)->toString();
    }
    catch (\InvalidArgumentException $e) {
      // A malformed URI would otherwise white-screen the whole view.
      continue;
    }
    $variables['pub_links'][$key] = [
      'url' => $url,
      'label' => $info['label'],
      'aria' => $info['aria'],
    ];
  }

  // BibTeX is generated by BibCite, not stored in a field.
  $variables['pub_bibtex'] = NULL;
  if (\Drupal::moduleHandler()->moduleExists('bibcite_bibtex')) {
    try {
      $bibtex = trim(\Drupal::service('serializer')->serialize($entity, 'bibtex'));
      if ($bibtex !== '') {
        $variables['pub_bibtex'] = $bibtex;
        $variables['pub_bibtex_id'] = Html::getUniqueId('pub-bibtex-' . $entity->id());
      }
    }
    catch (\Throwable $e) {
      \Drupal::logger('imagine_publications')->warning('BibTeX serialization failed for @id: @msg', [
        '@id' => $entity->id(),
        '@msg' => $e->getMessage(),
      ]);
    }
  }

  $variables['#attached']['library'][] = 'imagine_publications/publications';

  // Reading _entity directly bypasses the field render arrays that would
  // normally bubble this up.
  $variables['#cache']['tags'] = Cache::mergeTags(
    $variables['#cache']['tags'] ?? [],
    $entity->getCacheTags()
  );
}

/**
 * Implements hook_form_alter().
 *
 * Adds an opt-in layer to BibCite's normal import form. BibCite remains
 * responsible for creating references, contributors, etc. After its import
 * batch finishes, we fill the IMAGINE-only fields from extra BibTeX fields.
 */
function imagine_publications_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $form_object = $form_state->getFormObject();
  if (!is_object($form_object) || get_class($form_object) !== 'Drupal\\bibcite_import\\Form\\ImportForm') {
    return;
  }

  $form['imagine_publication_fields'] = [
    '#type' => 'checkbox',
    '#title' => t('Populate IMAGINE custom publication fields from BibTeX'),
    '#description' => t('Reads venue, venue_display, code, pdf, and journal_link (including common aliases) from .bib entries and stores them in the custom IMAGINE fields.'),
    '#default_value' => TRUE,
    '#weight' => 90,
  ];

  // Capture the uploaded BibTeX while it is definitely still available.
  $form['#validate'][] = 'imagine_publications_capture_bibtex_custom_fields';
  // BibCite's submit handler sets up its import batch first. This handler then
  // appends our post-processing batch sets, so they run after the references
  // have been created.
  $form['#submit'][] = 'imagine_publications_schedule_bibtex_custom_fields';
}

/**
 * Form validation callback: read and parse IMAGINE metadata from a .bib file.
 */
function imagine_publications_capture_bibtex_custom_fields(array &$form, FormStateInterface $form_state): void {
  if (!$form_state->getValue('imagine_publication_fields')) {
    return;
  }

  $contents = imagine_publications_get_uploaded_import_contents($form_state);
  if ($contents === NULL || trim($contents) === '') {
    return;
  }

  $entries = imagine_publications_parse_bibtex($contents);
  $metadata = [];

  foreach ($entries as $entry) {
    $fields = $entry['fields'];
    $custom = [
      'venue' => imagine_publications_first_bibtex_field($fields, [
        'venue',
      ]),
      'venue_display' => imagine_publications_first_bibtex_field($fields, [
        'venue_display', 'venue_display_name', 'venuedisplay', 'venuedisplayname',
      ]),
      'code' => imagine_publications_first_bibtex_field($fields, [
        'code', 'code_link', 'codelink', 'github', 'repository',
      ]),
      'pdf' => imagine_publications_first_bibtex_field($fields, [
        'pdf', 'pdf_link', 'pdflink',
      ]),
      'journal_link' => imagine_publications_first_bibtex_field($fields, [
        'journal_link', 'journallink', 'publisher_link', 'publisherlink',
      ]),
    ];

    // Do not schedule work for entries that contain no IMAGINE metadata.
    if (!array_filter($custom, static fn($value) => $value !== NULL && $value !== '')) {
      continue;
    }

    $metadata[] = [
      'key' => $entry['key'],
      'title' => $fields['title'] ?? '',
      'year' => $fields['year'] ?? '',
      'custom' => $custom,
    ];
  }

  if ($metadata) {
    $form_state->set('imagine_publications_bibtex_metadata', $metadata);
  }
}

/**
 * Submit callback: append IMAGINE post-processing to BibCite's import batch.
 */
function imagine_publications_schedule_bibtex_custom_fields(array &$form, FormStateInterface $form_state): void {
  $metadata = $form_state->get('imagine_publications_bibtex_metadata') ?: [];
  if (!$metadata) {
    return;
  }

  $operations = [];
  foreach (array_chunk($metadata, 25) as $chunk) {
    $operations[] = [
      'imagine_publications_apply_bibtex_custom_fields_batch',
      [$chunk],
    ];
  }

  batch_set([
    'title' => t('Applying IMAGINE publication metadata'),
    'operations' => $operations,
    'finished' => 'imagine_publications_apply_bibtex_custom_fields_finished',
  ]);
}

/**
 * Batch operation: match imported references and set custom IMAGINE fields.
 */
function imagine_publications_apply_bibtex_custom_fields_batch(array $metadata, array &$context): void {
  $storage = \Drupal::entityTypeManager()->getStorage('bibcite_reference');
  $ids = $storage->getQuery()->accessCheck(FALSE)->execute();
  $references = $storage->loadMultiple($ids);

  $updated = 0;
  $unmatched = [];

  foreach ($metadata as $entry) {
    $reference = imagine_publications_find_reference($references, $entry);
    if (!$reference instanceof EntityInterface) {
      $unmatched[] = $entry['title'] ?: $entry['key'];
      continue;
    }

    $changed = FALSE;
    $custom = $entry['custom'];

    $changed = imagine_publications_set_text_field($reference, 'field_bibcite_venue', $custom['venue']) || $changed;
    $changed = imagine_publications_set_text_field($reference, 'field_bibcite_venue_displayname', $custom['venue_display']) || $changed;
    $changed = imagine_publications_set_link_field($reference, 'field_bibcite_code_link', $custom['code']) || $changed;
    $changed = imagine_publications_set_link_field($reference, 'field_bibcite_pdf_link', $custom['pdf']) || $changed;
    $changed = imagine_publications_set_link_field($reference, 'field_bibcite_journal_link', $custom['journal_link']) || $changed;

    if ($changed) {
      try {
        $reference->save();
        $updated++;
      }
      catch (\Throwable $e) {
        \Drupal::logger('imagine_publications')->error('Could not save IMAGINE fields for reference @id: @msg', [
          '@id' => $reference->id(),
          '@msg' => $e->getMessage(),
        ]);
      }
    }
  }

  $context['results']['updated'] = ($context['results']['updated'] ?? 0) + $updated;
  $context['results']['unmatched'] = array_merge($context['results']['unmatched'] ?? [], $unmatched);
  $context['message'] = t('Updated @count publication(s) with IMAGINE metadata.', ['@count' => $updated]);
}

/**
 * Batch finished callback.
 */
function imagine_publications_apply_bibtex_custom_fields_finished(bool $success, array $results, array $operations): void {
  if (!$success) {
    \Drupal::messenger()->addError(t('BibCite import completed, but applying IMAGINE publication metadata did not finish successfully.'));
    return;
  }

  $updated = (int) ($results['updated'] ?? 0);
  \Drupal::messenger()->addStatus(t('Applied IMAGINE metadata to @count publication(s).', ['@count' => $updated]));

  $unmatched = array_values(array_unique(array_filter($results['unmatched'] ?? [])));
  if ($unmatched) {
    $preview = array_slice($unmatched, 0, 8);
    $suffix = count($unmatched) > count($preview) ? ' …' : '';
    \Drupal::messenger()->addWarning(t('Could not match @count BibTeX entrie(s) to imported references: @titles@more', [
      '@count' => count($unmatched),
      '@titles' => implode('; ', $preview),
      '@more' => $suffix,
    ]));
  }
}

/**
 * Reads the uploaded import file, supporting both raw and managed uploads.
 */
function imagine_publications_get_uploaded_import_contents(FormStateInterface $form_state): ?string {
  // First try a managed-file style form value.
  $value = $form_state->getValue('file');
  $candidate_ids = [];
  if (is_numeric($value)) {
    $candidate_ids[] = (int) $value;
  }
  elseif (is_array($value)) {
    array_walk_recursive($value, static function ($item) use (&$candidate_ids): void {
      if (is_numeric($item)) {
        $candidate_ids[] = (int) $item;
      }
    });
  }

  foreach (array_unique($candidate_ids) as $fid) {
    $file = \Drupal::entityTypeManager()->getStorage('file')->load($fid);
    if ($file) {
      $uri = $file->getFileUri();
      $data = @file_get_contents($uri);
      if ($data !== FALSE) {
        return $data;
      }
    }
  }

  // BibCite currently uses a normal upload element; find the Symfony
  // UploadedFile recursively without depending on its exact element name.
  $files = \Drupal::request()->files->all();
  $uploaded = imagine_publications_find_uploaded_file($files);
  if ($uploaded instanceof UploadedFile && $uploaded->isValid()) {
    $path = $uploaded->getRealPath();
    if ($path && is_readable($path)) {
      $data = @file_get_contents($path);
      if ($data !== FALSE) {
        return $data;
      }
    }
  }

  return NULL;
}

/**
 * Recursively finds the first uploaded file in a request-files array.
 */
function imagine_publications_find_uploaded_file(mixed $value): ?UploadedFile {
  if ($value instanceof UploadedFile) {
    return $value;
  }
  if (is_array($value)) {
    foreach ($value as $child) {
      $found = imagine_publications_find_uploaded_file($child);
      if ($found) {
        return $found;
      }
    }
  }
  return NULL;
}

/**
 * Finds a BibCite reference using citekey first, then normalized title/year.
 */
function imagine_publications_find_reference(array $references, array $entry): ?EntityInterface {
  $entry_key = imagine_publications_normalize_text($entry['key'] ?? '');
  $entry_title = imagine_publications_normalize_text($entry['title'] ?? '');
  $entry_year = trim((string) ($entry['year'] ?? ''));

  // Prefer an exact citation-key match when the installed BibCite version
  // exposes such a field.
  if ($entry_key !== '') {
    foreach ($references as $reference) {
      foreach (['bibcite_citekey', 'bibcite_key', 'citation_key'] as $field_name) {
        if ($reference->hasField($field_name) && !$reference->get($field_name)->isEmpty()) {
          $candidate = imagine_publications_normalize_text((string) $reference->get($field_name)->value);
          if ($candidate !== '' && $candidate === $entry_key) {
            return $reference;
          }
        }
      }
    }
  }

  if ($entry_title === '') {
    return NULL;
  }

  $title_matches = [];
  foreach ($references as $reference) {
    if (imagine_publications_normalize_text((string) $reference->label()) === $entry_title) {
      $title_matches[] = $reference;
    }
  }

  if (count($title_matches) === 1) {
    return reset($title_matches) ?: NULL;
  }

  // If duplicate titles exist, use year as a tie-breaker when possible.
  if ($entry_year !== '' && $title_matches) {
    foreach ($title_matches as $reference) {
      foreach (['bibcite_year', 'year'] as $field_name) {
        if ($reference->hasField($field_name) && !$reference->get($field_name)->isEmpty()) {
          if (trim((string) $reference->get($field_name)->value) === $entry_year) {
            return $reference;
          }
        }
      }
    }
  }

  return $title_matches[0] ?? NULL;
}

/**
 * Sets a plain-text field when a non-empty value is available.
 */
function imagine_publications_set_text_field(EntityInterface $entity, string $field_name, ?string $value): bool {
  if ($value === NULL || trim($value) === '' || !$entity->hasField($field_name)) {
    return FALSE;
  }

  $value = trim($value);
  $current = $entity->get($field_name)->isEmpty() ? '' : (string) $entity->get($field_name)->value;
  if ($current === $value) {
    return FALSE;
  }

  $entity->set($field_name, $value);
  return TRUE;
}

/**
 * Sets a Drupal link field when a non-empty URI is available.
 */
function imagine_publications_set_link_field(EntityInterface $entity, string $field_name, ?string $value): bool {
  if ($value === NULL || trim($value) === '' || !$entity->hasField($field_name)) {
    return FALSE;
  }

  $uri = imagine_publications_normalize_uri(trim($value));
  if ($uri === '') {
    return FALSE;
  }

  $current = '';
  if (!$entity->get($field_name)->isEmpty()) {
    $current = (string) ($entity->get($field_name)->first()->uri ?? '');
  }
  if ($current === $uri) {
    return FALSE;
  }

  $entity->set($field_name, ['uri' => $uri]);
  return TRUE;
}

/**
 * Normalizes a URL/URI for Drupal's Link field.
 */
function imagine_publications_normalize_uri(string $uri): string {
  $uri = trim($uri);
  if ($uri === '') {
    return '';
  }
  if (str_starts_with($uri, '/')) {
    return 'internal:' . $uri;
  }
  if (preg_match('@^[a-z][a-z0-9+.-]*:@i', $uri)) {
    return $uri;
  }
  if (preg_match('/^[\w.-]+\.[a-z]{2,}(?:\/|$)/i', $uri)) {
    return 'https://' . $uri;
  }
  return $uri;
}

/**
 * Returns the first present BibTeX field from a list of aliases.
 */
function imagine_publications_first_bibtex_field(array $fields, array $aliases): ?string {
  foreach ($aliases as $alias) {
    $alias = strtolower($alias);
    if (isset($fields[$alias]) && trim((string) $fields[$alias]) !== '') {
      return trim((string) $fields[$alias]);
    }
  }
  return NULL;
}

/**
 * Lightweight BibTeX parser for entry-level metadata.
 *
 * This is deliberately not a replacement for BibCite's parser. It only reads
 * enough of the source file to preserve the five IMAGINE-specific fields.
 * BibCite still performs the actual bibliography import.
 */
function imagine_publications_parse_bibtex(string $bibtex): array {
  $entries = [];
  $length = strlen($bibtex);
  $i = 0;

  while ($i < $length) {
    $at = strpos($bibtex, '@', $i);
    if ($at === FALSE) {
      break;
    }
    $i = $at + 1;

    while ($i < $length && ctype_space($bibtex[$i])) {
      $i++;
    }

    $type_start = $i;
    while ($i < $length && preg_match('/[A-Za-z]/', $bibtex[$i])) {
      $i++;
    }
    $type = strtolower(substr($bibtex, $type_start, $i - $type_start));

    while ($i < $length && ctype_space($bibtex[$i])) {
      $i++;
    }
    if ($i >= $length || ($bibtex[$i] !== '{' && $bibtex[$i] !== '(')) {
      continue;
    }

    $open = $bibtex[$i];
    $close = $open === '{' ? '}' : ')';
    $body_start = ++$i;
    $depth = 1;
    $in_quote = FALSE;
    $escaped = FALSE;

    while ($i < $length && $depth > 0) {
      $char = $bibtex[$i];
      if ($escaped) {
        $escaped = FALSE;
      }
      elseif ($char === '\\') {
        $escaped = TRUE;
      }
      elseif ($char === '"') {
        $in_quote = !$in_quote;
      }
      elseif (!$in_quote) {
        if ($char === $open) {
          $depth++;
        }
        elseif ($char === $close) {
          $depth--;
        }
      }
      $i++;
    }

    if ($depth !== 0) {
      break;
    }

    if (in_array($type, ['string', 'comment', 'preamble'], TRUE)) {
      continue;
    }

    $body = substr($bibtex, $body_start, ($i - 1) - $body_start);
    [$key, $field_text] = imagine_publications_split_bibtex_key_and_fields($body);
    if ($key === '') {
      continue;
    }

    $entries[] = [
      'type' => $type,
      'key' => $key,
      'fields' => imagine_publications_parse_bibtex_fields($field_text),
    ];
  }

  return $entries;
}

/**
 * Splits the citation key from the field list at the first top-level comma.
 */
function imagine_publications_split_bibtex_key_and_fields(string $body): array {
  $depth = 0;
  $in_quote = FALSE;
  $escaped = FALSE;
  $length = strlen($body);

  for ($i = 0; $i < $length; $i++) {
    $char = $body[$i];
    if ($escaped) {
      $escaped = FALSE;
      continue;
    }
    if ($char === '\\') {
      $escaped = TRUE;
      continue;
    }
    if ($char === '"') {
      $in_quote = !$in_quote;
      continue;
    }
    if ($in_quote) {
      continue;
    }
    if ($char === '{' || $char === '(') {
      $depth++;
    }
    elseif ($char === '}' || $char === ')') {
      $depth = max(0, $depth - 1);
    }
    elseif ($char === ',' && $depth === 0) {
      return [trim(substr($body, 0, $i)), substr($body, $i + 1)];
    }
  }

  return [trim($body), ''];
}

/**
 * Parses top-level name=value pairs from a BibTeX entry body.
 */
function imagine_publications_parse_bibtex_fields(string $text): array {
  $fields = [];
  $length = strlen($text);
  $i = 0;

  while ($i < $length) {
    while ($i < $length && (ctype_space($text[$i]) || $text[$i] === ',')) {
      $i++;
    }
    if ($i >= $length) {
      break;
    }

    $name_start = $i;
    while ($i < $length && preg_match('/[A-Za-z0-9_:-]/', $text[$i])) {
      $i++;
    }
    $name = strtolower(trim(substr($text, $name_start, $i - $name_start)));

    while ($i < $length && ctype_space($text[$i])) {
      $i++;
    }
    if ($name === '' || $i >= $length || $text[$i] !== '=') {
      $next = strpos($text, ',', $i);
      $i = $next === FALSE ? $length : $next + 1;
      continue;
    }

    $i++;
    while ($i < $length && ctype_space($text[$i])) {
      $i++;
    }

    [$raw_value, $i] = imagine_publications_read_bibtex_value($text, $i);
    $fields[$name] = imagine_publications_clean_bibtex_value($raw_value);
  }

  return $fields;
}

/**
 * Reads one BibTeX value while respecting nested braces and quoted strings.
 */
function imagine_publications_read_bibtex_value(string $text, int $start): array {
  $length = strlen($text);
  if ($start >= $length) {
    return ['', $start];
  }

  $first = $text[$start];
  if ($first === '{') {
    $depth = 1;
    $escaped = FALSE;
    $i = $start + 1;
    while ($i < $length && $depth > 0) {
      $char = $text[$i];
      if ($escaped) {
        $escaped = FALSE;
      }
      elseif ($char === '\\') {
        $escaped = TRUE;
      }
      elseif ($char === '{') {
        $depth++;
      }
      elseif ($char === '}') {
        $depth--;
      }
      $i++;
    }
    return [substr($text, $start, $i - $start), $i];
  }

  if ($first === '"') {
    $escaped = FALSE;
    $i = $start + 1;
    while ($i < $length) {
      $char = $text[$i];
      if ($escaped) {
        $escaped = FALSE;
      }
      elseif ($char === '\\') {
        $escaped = TRUE;
      }
      elseif ($char === '"') {
        $i++;
        break;
      }
      $i++;
    }
    return [substr($text, $start, $i - $start), $i];
  }

  $i = $start;
  while ($i < $length && $text[$i] !== ',') {
    $i++;
  }
  return [substr($text, $start, $i - $start), $i];
}

/**
 * Removes one set of BibTeX delimiters and normalizes whitespace.
 */
function imagine_publications_clean_bibtex_value(string $value): string {
  $value = trim($value);
  if (strlen($value) >= 2) {
    $first = $value[0];
    $last = $value[strlen($value) - 1];
    if (($first === '{' && $last === '}') || ($first === '"' && $last === '"')) {
      $value = substr($value, 1, -1);
    }
  }
  return trim(preg_replace('/\s+/u', ' ', $value) ?? $value);
}

/**
 * Normalizes strings for safe title/citekey matching after BibCite import.
 */
function imagine_publications_normalize_text(string $value): string {
  $value = html_entity_decode($value, ENT_QUOTES | ENT_HTML5, 'UTF-8');
  // BibTeX often uses braces only to protect capitalization.
  $value = str_replace(['{', '}'], '', $value);
  $value = preg_replace('/\\\\([%&_#{}])/', '$1', $value) ?? $value;
  $value = preg_replace('/[^\p{L}\p{N}]+/u', ' ', $value) ?? $value;
  $value = trim(preg_replace('/\s+/u', ' ', $value) ?? $value);
  return mb_strtolower($value, 'UTF-8');
}
