<?php

/**
 * @file
 * Functions to support theming in the Imagine theme.
 */

use Drupal\node\NodeInterface;
use Drupal\paragraphs\Entity\Paragraph;


function imagine_preprocess_html(&$variables) {
  // Get the current route object to see if we are viewing a node
  $node = \Drupal::routeMatch()->getParameter('node');
  
  // Ensure we actually have a valid node object
  if ($node instanceof NodeInterface) {
    // This adds the node ID as a class to to the <body> tag (e.g., "node-id-123")
    $variables['attributes']['class'][] = 'node-id-' . $node->id();
    
    // This adds the node type as a class to to the <body> tag (e.g., "node-type-members")
    $variables['attributes']['class'][] = 'node-type-' . $node->bundle();
  }
}

function imagine_preprocess_field(&$variables) {

  // Make adjustments to the alumni list's website links.
  if ($variables['field_name'] === 'field_alumni_websites') {

    // Get the parent Paragraph entity (Alumni) that holds this field.
    $paragraph = $variables['element']['#object'];

    // Retrieve the Alumnus's name from the sibling field.
    $name = '';
    if ($paragraph->hasField('field_alumni_name') && !$paragraph->get('field_alumni_name')->isEmpty()) {
      $name = trim((string) $paragraph->get('field_alumni_name')->value);
    }

    // Loop through each link item rendering array.
    foreach ($variables['items'] as $delta => &$item) {

      // Ensure we are working with a valid link render structure.
      if (isset($item['content']['#type']) && $item['content']['#type'] === 'link') {

        // Grab the individual link's title (e.g. "LinkedIn" or "Website").
        $link_title = trim((string) $item['content']['#title']);

        // Build the custom aria label: "LinkedIn for [Person's Name]".
        $custom_aria = ($name !== '' && $link_title !== '')
          ? $link_title . ' for ' . $name
          : $link_title;

        // Add the aria-label directly onto the <a> tag options.
        if ($custom_aria !== '') {
          $item['content']['#options']['attributes']['aria-label'] = $custom_aria;
        }

        // Initialize the class array if it doesn't exist.
        if (!isset($item['content']['#options']['attributes']['class'])) {
          $item['content']['#options']['attributes']['class'] = [];
        }

        // Add custom button style to these links.
        $item['content']['#options']['attributes']['class'][] = 'imagine-btn';
      }
    }
    // Break the reference from the loop above.
    unset($item);
  }

  // Make adjustments to the members roles and dates field.
  if ($variables['field_name'] === 'field_roles_dates') {
    $clean_roles = [];

    // Loop through each paragraph item in the field.
    foreach ($variables['items'] as $delta => $item) {

      // Get the paragraph entity directly from the render element.
      if (isset($item['content']['#paragraph'])) {
        /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
        $paragraph = $item['content']['#paragraph'];

        // Extract role.
        $role = $paragraph->hasField('field_member_role') && !$paragraph->get('field_member_role')->isEmpty()
          ? trim((string) $paragraph->get('field_member_role')->value)
          : '';

        // Extract start/end years.
        $start = $paragraph->hasField('field_member_start') && !$paragraph->get('field_member_start')->isEmpty()
          ? trim((string) $paragraph->get('field_member_start')->value)
          : '';
        $end = $paragraph->hasField('field_member_end') && !$paragraph->get('field_member_end')->isEmpty()
          ? trim((string) $paragraph->get('field_member_end')->value)
          : '';

        // Build the dates portion.
        $date_string = '';
        if ($start && !$end) {
          $date_string = " ({$start}—)";
        }
        elseif ($start && $end) {
          $date_string = " ({$start}-{$end})";
        }
        elseif ($end) {
          $date_string = " ({$end})";
        }

        // Combine role and dates.
        $full_text = $role . $date_string;

        if ($full_text !== '') {
          $clean_roles[] = $full_text;
        }
      }
    }

    // Replace the entire field items render array with our clean, joined string.
    if (!empty($clean_roles)) {
      $variables['items'] = [
        [
          'content' => [
            '#plain_text' => implode('; ', $clean_roles),
          ],
        ],
      ];
    }
  }
}


function imagine_preprocess_views_view_fields(&$variables) {
  $view = $variables['view'];
  
  if ($view->id() === 'members' && $view->current_display === 'current_members') {
    
    $row = $variables['row'];
    $entity = $row->_entity;
    
    if ($entity && $entity->hasField('field_websites')) {
      $member_title = $entity->label(); 
      $custom_links = [];
      
      if (isset($variables['fields']['field_websites'])) {
        
        foreach ($entity->get('field_websites') as $delta => $link_item) {
          
          // Get the URL string and the user-entered link text
          $url = $link_item->getUrl()->toString();
          $link_text = $link_item->title;
          
          // Construct the dynamic aria label safely
          $aria_label = t("@text for @name", ['@text' => $link_text, '@name' => $member_title]);
          
          // Build the complete anchor tag
          $custom_links[] = '<a href="' . $url . '" class="imagine-btn" aria-label="' . $aria_label . '">' . $link_text . '</a>';
        }
        
        // Overwrite the member view markup with custom tag string
        if (!empty($custom_links)) {
          $variables['fields']['field_websites']->content = \Drupal\Core\Render\Markup::create(implode(' ', $custom_links));
        }
      }
    }
  }
}